{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WallpaperStudio",
  "version": "0.1.0",
  "identifier": "com.wallpaperstudio.app",
  "build": {
    "frontendDist": "../public",
    "devUrl": "../public"
  },
  "app": {
    "windows": [
      {
        "title": "WallpaperStudio — Native 4K Wallpaper Generator",
        "width": 1280,
        "height": 840,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
