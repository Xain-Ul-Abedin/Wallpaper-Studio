{
  "name": "wallpaper-studio",
  "version": "1.0.2",
  "description": "Studio-grade 4K & iPhone Minimalist Wallpaper Generator Windows Desktop App",
  "main": "main_desktop.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder -wml",
    "tauri": "tauri"
  },
  "build": {
    "appId": "com.wallpaperstudio.app",
    "productName": "WallpaperStudio",
    "directories": {
      "output": "dist",
      "app": "."
    },
    "files": [
      "main_desktop.js",
      "preload.js",
      "package.json",
      "app/dist/**/*"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "WallpaperStudio-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "WallpaperStudio"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.graphics-design",
      "artifactName": "WallpaperStudio-${version}.${ext}"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Graphics",
      "maintainer": "WallpaperStudio Team <team@wallpaperstudio.com>",
      "artifactName": "WallpaperStudio-${version}.${ext}"
    }
  },
  "keywords": [
    "wallpaper",
    "generator",
    "desktop",
    "tauri",
    "electron"
  ],
  "author": "WallpaperStudio Team <team@wallpaperstudio.com>",
  "license": "MIT",
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3"
  }
}
